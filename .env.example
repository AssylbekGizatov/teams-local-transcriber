# Copy with `python scripts/generate_env.py` to generate distinct secret tokens.
APP_API_TOKEN=
ASR_API_TOKEN=
DATA_DIR=./data
ASR_BACKEND=gigaam
ASR_MODEL_PATH=./models/gigaam
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CHUNK_SECONDS=20
MAX_UPLOAD_MB=500
MAX_AUDIO_SECONDS=14400
MAX_PENDING_JOBS=32
MAX_INFERENCE_QUEUE=4
RETAIN_AUDIO=false
# Local purge script threshold. No deletion schedule is enabled automatically.
RETENTION_DAYS=30
WORKER_ENABLED=true
POLL_SECONDS=5
TRUSTED_HOSTS=localhost,127.0.0.1,asr-app,platform
# Experimental connector. Leave disabled until documented approval and pilot testing.
TEAMS_ENABLED=false
TEAMS_AUTHORIZATION_REFERENCE=
# Exact approved native meeting IDs required; comma separated. Tenant hints alone do not authorize.
TEAMS_ALLOWED_MEETING_IDS=
TEAMS_ALLOWED_TENANT_IDS=
VEXA_API_URL=http://vexa-gateway:8000
VEXA_API_KEY=
BOT_NAME=Meeting transcription (local ASR)

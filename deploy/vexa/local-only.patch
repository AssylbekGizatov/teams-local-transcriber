diff --git a/core/meetings/services/bot/src/local-gigaam-pipeline.ts b/core/meetings/services/bot/src/local-gigaam-pipeline.ts
new file mode 100644
index 0000000..5add09c
--- /dev/null
+++ b/core/meetings/services/bot/src/local-gigaam-pipeline.ts
@@ -0,0 +1,68 @@
+import type { BotPipeline, Transcribe } from './pipeline.js';
+import type { TranscriptSink } from './ports.js';
+
+/** Local CTC: submit each PCM window once; no Whisper agreement or speaker inference. */
+export function createLocalGigaamPipeline(transcribe: Transcribe, sink: TranscriptSink, onError?: (error: unknown) => void): BotPipeline {
+  const rate = 16000, windowSamples = rate * 20, maxQueued = 4;
+  let parts: Float32Array[] = [], count = 0, startMs = 0, sequence = 0, queued = 0, closed = false;
+  let tail: Promise<void> = Promise.resolve();
+  let lastVoiceAt = 0;
+  let previousEndMs = 0, overloaded = false;
+  const report = onError ?? ((error: unknown) => console.error('[local-gigaam] ' + String(error)));
+  const reportOverload = () => {
+    if (!overloaded) report(new Error('Local GigaAM cannot keep up; bounded queue reached and audio was dropped.'));
+    overloaded = true;
+  };
+  const flush = () => {
+    if (!count) return;
+    const pcm = new Float32Array(count);
+    let offset = 0;
+    for (const part of parts) { pcm.set(part, offset); offset += part.length; }
+    const begin = startMs, end = begin + pcm.length / rate * 1000, id = `local-gigaam-${++sequence}`;
+    parts = []; count = 0;
+    queued++;
+    tail = tail.then(async () => {
+      try {
+        const result = await transcribe(pcm);
+        if (result.text.trim()) await sink.publish({segment_id: id, speaker: '', speaker_key: 'local-mix', text: result.text.trim(), start: begin / 1000, end: end / 1000, completed: true, language: result.language, absolute_start_time: new Date(begin).toISOString(), absolute_end_time: new Date(end).toISOString(), source: 'merged'});
+      } catch (error) { report(error); }
+      finally { queued--; }
+    });
+  };
+  const timer = setInterval(() => { if (count && Date.now() - lastVoiceAt >= 1200) flush(); }, 300);
+  timer.unref();
+  return {
+    async start() {},
+    async stop() { closed = true; clearInterval(timer); flush(); await tail; },
+    feedAudio() {},
+    feedMixedAudio(pcm, tsMs) {
+      if (closed || !pcm.length) return;
+      if (!Number.isFinite(tsMs)) { report(new Error('Local GigaAM received an invalid PCM timestamp.')); return; }
+      // A browser suspension/reconnect must not compress missing seconds into
+      // a continuous phrase. Publish the earlier audio as its own segment.
+      if (count && tsMs > previousEndMs + 500) flush();
+      previousEndMs = tsMs + pcm.length / rate * 1000;
+      let energy = 0;
+      for (const value of pcm) energy += value * value;
+      const voiced = Math.sqrt(energy / pcm.length) > 0.0001;
+      if (voiced) lastVoiceAt = Date.now();
+      if (!count && !voiced) return;
+      if (queued >= maxQueued) { reportOverload(); return; }
+      overloaded = false;
+      let offset = 0;
+      while (offset < pcm.length) {
+        if (!count && !voiced) break;
+        if (queued >= maxQueued) { reportOverload(); break; }
+        if (!count) startMs = tsMs + offset / rate * 1000;
+        const size = Math.min(windowSamples - count, pcm.length - offset);
+        parts.push(pcm.slice(offset, offset + size)); count += size; offset += size;
+        if (count === windowSamples) flush();
+      }
+    },
+    recordHint() {},
+    recordTransportEvent() {},
+    recordCaptionName() {},
+    recordRosterName() {},
+    recordRosterCoverage() {},
+  };
+}

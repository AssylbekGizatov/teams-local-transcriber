# syntax=docker/dockerfile:1
# Vexa source revision is checked and patched by scripts/vendor_vexa.sh.
# No unpublished/floating vexa/meet-join-env image, agent runtime, or cloud STT.
FROM mcr.microsoft.com/playwright:v1.56.0-noble AS builder
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright CI=1
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /build
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json turbo.json ./
COPY core ./core
COPY scripts ./scripts
RUN --mount=type=cache,id=teams-vexa-pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm --filter "@vexa/capture-codec" --filter "@vexa/gmeet-capture" --filter "@vexa/mixed-capture-core" --filter "@vexa/record-chunker" --filter "@vexa/jitsi-capture" --filter "@vexa/teams-capture" --filter "@vexa/zoom-capture" run build
RUN pnpm --filter "@vexa/bot..." run build
ENV VEXA_HF_CACHE=/opt/hf-cache
# A missing model must fail the build, never trigger a runtime network download.
RUN node core/meetings/services/bot/warm-hf-cache.mjs && VEXA_HF_OFFLINE=1 node core/meetings/services/bot/warm-hf-cache.mjs
RUN cd /opt/hf-cache/onnx-community/pyannote-segmentation-3.0/733a93b6473d019a773298e08cefa686894b1854 \
 && echo "057ee564753071c0b09b5b611648b50ac188d50846bff5f01e9f7bbf1591ea25  onnx/model.onnx" | sha256sum -c - \
 && echo "5a4c6bb4f49f1b47c9bd398aac78b8cd4a9f30a0ff91b5c2dc68d05e13e160cf  config.json" | sha256sum -c - \
 && echo "dfc7d35a3895f8997eb94521e28b1921c03480a34fa9bcbb6bef1f1934f81480  preprocessor_config.json" | sha256sum -c -
RUN test -s core/meetings/services/bot/dist/index.js && test -s core/meetings/services/bot/dist/browser-utils.global.js

FROM mcr.microsoft.com/playwright:v1.56.0-noble AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends xvfb fluxbox pulseaudio xdotool xclip ca-certificates && rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 VEXA_HF_CACHE=/opt/hf-cache VEXA_HF_OFFLINE=1 HF_HUB_OFFLINE=1 VEXA_CAPTURE_SIGNAL=0 VEXA_TEAMS_ENABLE_CAPTIONS=0 BOT_MAX_ACTIVE_MS=7200000
WORKDIR /app
COPY --from=builder /build /app
COPY --from=builder /opt/hf-cache /opt/hf-cache
COPY licenses/onnx-community-pyannote-segmentation-3.0.LICENSE.txt /opt/hf-cache/LICENSE.pyannote-segmentation-3.0
COPY LICENSE THIRD_PARTY_LICENSES.md /app/
COPY core/meetings/services/bot/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
# No VNC/CDP ports are published and no credentials/session storage is mounted.
ENTRYPOINT ["/app/entrypoint.sh"]
